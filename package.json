{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "check-style": "eslint .",
        "fix-style": "eslint . --fix",
        "test-feature": "vitest run resources/js/tests/feature --passWithNoTests",
        "test-unit": "vitest run resources/js/tests/unit --passWithNoTests",
        "test": "vitest run --passWithNoTests",
        "analyze": "tsc --noEmit",
        "ci": "npm run check-style && npm run test && npm run analyze"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.72.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.10",
        "@inertiajs/react": "^2.3.29",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-collapsible": "^1.2.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-navigation-menu": "^1.4.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-toggle": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.6",
        "globals": "^17.13.0",
        "laravel-vite-plugin": "^1.0",
        "lucide-react": "^1.61.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.0.0",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.7.2",
        "vite": "^6.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-arm64-musl": "4.65.0",
        "@rollup/rollup-linux-x64-gnu": "4.65.0",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    }
}
