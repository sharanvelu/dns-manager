# VCS / CI
.git
.gitignore
.gitattributes
.github

# Dependencies (rebuilt inside the image)
node_modules
vendor

# Build output (produced in the assets stage)
public/build
public/hot
public/storage

# Environment / secrets — never bake into the image
.env
.env.*
*.key
auth.json

# Runtime state from local dev
storage/logs
storage/framework/cache
storage/framework/sessions
storage/framework/testing
storage/framework/views
storage/pail
bootstrap/cache
database/database.sqlite

# Tests & tooling not needed at runtime
tests
phpunit.xml
.npmrc
# docs-site's own .npmrc must ship: it re-enables install scripts that the
# root .npmrc turns off (Next.js/SWC need them in the docs build stage).
!docs-site/.npmrc
.prettierrc
.prettierignore
.editorconfig

# Deployment artifacts (not part of the app itself)
k8s
Dockerfile
.dockerignore
docker-compose*.yml

# The docs site source is needed (its static export is built in the docs
# stage and served at /docs) — only its build/install output is excluded.
docs-site/node_modules
docs-site/.next
docs-site/out
docs-site/*.tsbuildinfo

# Docs / editor cruft (the docs stage copies docs-site/ explicitly; the
# runtime image needs no markdown)
*.md
.vscode
.idea
.DS_Store
npm-debug.log*
